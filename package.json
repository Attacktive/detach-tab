{
	"name": "detach-tab",
	"version": "3.1.2",
	"description": "Detach and Reattach tab with customizable keyboard shortcuts - Cross-browser TypeScript edition",
	"main": "dist/background.js",
	"scripts": {
		"build": "bun run clean && bun run build:firefox && bun run build:chrome",
		"build:firefox": "webpack --config webpack.firefox.js",
		"build:chrome": "webpack --config webpack.chrome.js",
		"clean": "rimraf dist-firefox dist-chrome",
		"lint": "eslint src --ext .ts,.js",
		"lint:fix": "eslint src --ext .ts,.js --fix",
		"type-check": "tsc --noEmit",
		"watch": "bun run build --watch"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/chrome": "^0.2.7",
		"@types/firefox-webext-browser": "^143.0.0",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"copy-webpack-plugin": "^14.0.0",
		"eslint": "^10.9.1",
		"globals": "^17.11.0",
		"html-webpack-plugin": "^5.6.8",
		"rimraf": "^6.1.3",
		"ts-loader": "^9.6.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"webextension-polyfill": "^0.12.0",
		"webpack": "^5.110.1",
		"webpack-cli": "^7.2.3",
		"webpack-merge": "^6.0.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Attacktive/detach-tab"
	},
	"author": "Claymont",
	"license": "MPL-2.0",
	"private": true,
	"type": "module"
}
